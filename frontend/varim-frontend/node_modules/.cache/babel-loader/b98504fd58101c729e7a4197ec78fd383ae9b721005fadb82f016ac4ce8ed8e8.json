mer\" onClick={onFermer}>\r\n            <X size={20} />\r\n          </button>\r\n        </div>\r\n\r\n        <p className=\"partager-titre\">{titre}</p>\r\n\r\n        <div className=\"partager-reseaux\">\r\n          <button className=\"partager-reseau whatsapp\" onClick={partagerWhatsApp}>\r\n            <span className=\"reseau-icone\">W</span>\r\n            WhatsApp\r\n          </button>\r\n          <button className=\"partager-reseau facebook\" onClick={partagerFacebook}>\r\n            <span className=\"reseau-icone\">f</span>\r\n            Facebook\r\n          </button>\r\n          <button className=\"partager-reseau twitter\" onClick={partagerTwitter}>\r\n            <span className=\"reseau-icone\">X</span>\r\n            Twitter/X\r\n          </button>\r\n        </div>\r\n\r\n        <div className=\"partager-lien\">\r\n          <input\r\n            type=\"text\"\r\n            value={lien}\r\n            readOnly\r\n            className=\"partager-lien-input\"\r\n          />\r\n          <button className=\"partager-copier\" onClick={copierLien}>\r\n            {copie ? <Check size={16} /> : <Copy size={16} />}\r\n            {copie ? 'Copié !' : 'Copier'}\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Partager;"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,QAAQ,KAAQ,OAAO,CACvC,OAASC,MAAM,CAAEC,IAAI,CAAEC,KAAK,CAAEC,CAAC,KAAQ,cAAc,CACrD,MAAO,gBAAgB,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAExB,QAAS,CAAAC,QAAQA,CAAAC,IAAA,CAA4B,IAA3B,CAAEC,IAAI,CAAEC,KAAK,CAAEC,QAAS,CAAC,CAAAH,IAAA,CACzC,KAAM,CAACI,KAAK,CAAEC,QAAQ,CAAC,CAAGf,QAAQ,CAAC,KAAK,CAAC,CAEzC,KAAM,CAAAgB,UAAU,CAAGA,CAAA,GAAM,CACvBC,SAAS,CAACC,SAAS,CAACC,SAAS,CAACR,IAAI,CAAC,CACnCI,QAAQ,CAAC,IAAI,CAAC,CACdK,UAAU,CAAC,IAAML,QAAQ,CAAC,KAAK,CAAC,CAAE,IAAI,CAAC,CACzC,CAAC,CAED,KAAM,CAAAM,gBAAgB,CAAGA,CAAA,GAAM,CAC7BC,MAAM,CAACC,IAAI,CAAC,uBAAuBC,kBAAkB,CAACZ,KAAK,CAAG,KAAK,CAAGD,IAAI,CAAC,EAAE,CAAE,QAAQ,CAAC,CAC1F,CAAC,CAED,